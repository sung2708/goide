{
  "name": "goide",
  "private": true,
  "version": "0.5.0-alpha.2",
  "description": "A desktop IDE for Go editing, runtime inspection, and concurrency workflows.",
  "license": "MIT",
  "homepage": "https://github.com/sung2708/goide",
  "repository": {
    "type": "git",
    "url": "https://github.com/sung2708/goide.git"
  },
  "keywords": [
    "go",
    "ide",
    "tauri",
    "react",
    "debugger"
  ],
  "type": "module",
  "scripts": {
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-wrapper.mjs",
    "tauri:dev:msvc": "set CC=cl&& set CXX=cl&& npm run tauri -- dev",
    "cargo:check:msvc": "set CC=cl&& set CXX=cl&& set HOST_CC=cl&& set HOST_CXX=cl&& cargo check --manifest-path src-tauri/Cargo.toml",
    "cargo:test:msvc": "set CC=cl&& set CXX=cl&& set HOST_CC=cl&& set HOST_CXX=cl&& cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "version:check": "node scripts/version-manager.mjs check",
    "version:set": "node scripts/version-manager.mjs set",
    "docs:check": "node scripts/validate-docs.mjs",
    "changelog:generate": "node scripts/generate-changelog.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@gitgraph/react": "^1.6.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "monaco-editor": "^0.52.2",
    "monaco-vim": "^0.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.0.2",
    "semver": "^7.7.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  }
}
